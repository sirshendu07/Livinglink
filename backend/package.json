{
  "name": "livinglink-backend",
  "version": "1.0.0",
  "description": "LivingLink - Advanced Society Management System Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "jest --runInBand --coverage --detectOpenHandles --forceExit",
    "bootstrap-admin": "node scripts/bootstrapAdmin.js",
    "seed": "node scripts/seedAmenities.js"
  },
  "keywords": [
    "society-management",
    "express",
    "mongodb",
    "redis",
    "socketio",
    "jwt",
    "zod"
  ],
  "author": "LivingLink Engineering",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "nodemailer": "^6.10.0",
    "pdfkit": "^0.16.0",
    "pino": "^9.6.0",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.3",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "verbose": true,
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
