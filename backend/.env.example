# LivingLink Environment Configuration Example
# Copy this file to .env and configure the values for your environment.

# Server
NODE_ENV=development
PORT=5000

# MongoDB (e.g. mongodb+srv://<user>:<password>@cluster.mongodb.net/livinglink?retryWrites=true&w=majority)
MONGODB_URI=mongodb://localhost:27017/livinglink

# Redis (Upstash Redis rediss:// URL or local redis:// URL)
REDIS_URL=redis://localhost:6379

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Nodemailer / Gmail SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_FROM="LivingLink Society" <no-reply@livinglink.local>

# CORS & Frontend URLs (comma-separated if multiple)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Temporary Demo Payment Configuration
PAYMENT_DEMO_SECRET=LivingLinkDemoPay2026!
DEMO_PAYMENTS_ENABLED=true

# Admin Bootstrap Credentials (Used by scripts/bootstrapAdmin.js)
ADMIN_BOOTSTRAP_EMAIL=admin@livinglink.society
ADMIN_BOOTSTRAP_PASSWORD=AdminSecurePass#2026
ADMIN_BOOTSTRAP_NAME=Super Admin
ADMIN_BOOTSTRAP_PHONE=+919876543210

# Optional Cloudinary Configuration
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Logging level (debug, info, warn, error)
LOG_LEVEL=info
